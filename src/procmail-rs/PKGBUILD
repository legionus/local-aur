# Maintainer: Alexey Gladkov <gladkov.alexey@gmail.com>

pkgname=procmail-rs
pkgver=0.3.0
pkgrel=1
pkgdesc="Mail processing and sorting program"
arch=('x86_64' 'aarch64')
url="https://github.com/legionus/procmail-rs"
license=('MIT')
source=(
	"procmail-${pkgver}.tar.gz::https://github.com/legionus/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=('584a89bf8edb15cbc982cca1d8f6ebfde38b0b75b5c3b197646c55569d6ff9a1')

prepare() {
	cd $pkgname-$pkgver
}

build() {
	cd $pkgname-$pkgver
	make build-release
}

package() {
	cd $pkgname-$pkgver
	make install \
		DESTDIR="$pkgdir" \
		PREFIX=/usr
}
