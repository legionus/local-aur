# Maintainer: Alexey Gladkov <gladkov.alexey@gmail.com>

pkgname=procmail-rs
pkgver=0.2.0
pkgrel=1
pkgdesc="Mail processing and sorting program"
arch=('x86_64' 'aarch64')
url="https://github.com/legionus/procmail-rs"
license=('MIT')
source=(
	"procmail-${pkgver}.tar.gz::https://github.com/legionus/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=('708eeae1d28dd04892ac8229e172e14a6b65ca673887ce0b88882617376b0e72')

prepare() {
	cd $pkgname-$pkgver
}

build() {
	cd $pkgname-$pkgver
	make build-release
}

package() {
	cd $pkgname-$pkgver
	make install \
		DESTDIR="$pkgdir" \
		PREFIX=/usr
}
