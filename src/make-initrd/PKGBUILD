# Maintainer: Alexey Gladkov <gladkov.alexey@gmail.com>

pkgname=make-initrd
pkgver=2.61.0
pkgrel=1
pkgdesc="Uevent-driven initramfs infrastructure based around udev"
arch=('any')
url="https://github.com/osboot/make-initrd"
license=('GPL-3.0-or-later')
depends=(
	bzip2
	cpio
	json-c
	libshell
	make
	xz
	zlib
	zstd
)
makedepends=(
	scdoc
)
source=(
	https://github.com/osboot/make-initrd/releases/download/$pkgver/make-initrd-$pkgver.tar.xz
)
sha256sums=(
	'2da1217756ed78e2430dc4cd7266b9e2796924f9864a93bbaa7ef43c09408aa1'
)
backup=('etc/initrd.mk')

prepare() {
	cd "${pkgname}-${pkgver}"
	autoreconf -if
}

build() {
	cd "${pkgname}-${pkgver}"
	./configure \
		--prefix=/usr \
		--bindir=/usr/bin \
		--sbindir=/usr/bin \
		--sysconfdir=/etc \
		--with-bootdir=/boot \
		--with-runtimedir=/usr/lib/initramfs \
		--libexecdir=/usr/libexec \
		--with-imagename='initramfs-$(KERNEL)$(IMAGE_SUFFIX).img' \
		--with-busybox \
		--without-libshell \
		--with-libelf \
		--with-zlib \
		--with-bzip2 \
		--with-lzma \
		--with-zstd \
		--with-json-c \
		--with-scdoc \
		#
	make
}

package() {
	cd "${pkgname}-${pkgver}"
	make install DESTDIR="${pkgdir}"
}
